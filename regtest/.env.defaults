# ──────────────────────────────────────────────────────────────────────────────
# arkade-regtest defaults
#
# Override any of these in a `.env` (local) or `../.env.regtest` (parent repo),
# or pass an explicit file: `node regtest.mjs start --env path/to/env`.
# Precedence: --env  >  ../.env.regtest  >  .env  > these defaults.
#
# This environment is fully self-contained — it no longer depends on nigiri.
# The chain/indexer/explorer stack (Bitcoin Core + Fulcrum + mempool) and the
# Ark stack are orchestrated directly via docker compose by regtest.mjs.
# ──────────────────────────────────────────────────────────────────────────────

# ── Profiles ─────────────────────────────────────────────────────────────────
# Profiles to bring up on `start`, comma-separated (e.g. "lightning" or "ark,solver").
# Dependencies resolve automatically; empty = full stack. A `--profile` flag on
# the command line overrides this.
REGTEST_PROFILES=

# ── Base layer images (chain / indexer / explorer / counterparty LN) ─────────
# BTCPay images for Bitcoin Core and the counterparty LND so their config can be
# embedded via BITCOIN_EXTRA_ARGS / LND_EXTRA_ARGS (set in docker/compose.base.yml)
# instead of bind-mounting conf files.
#
# Latest btcpay bitcoin. Requires nbxplorer >= 2.6.1, which fixed parsing of
# Core 31's getpeerinfo response (NBitcoin); we pin nbxplorer 2.6.7 below.
# Earlier nbxplorer (2.6.0) crash-loops on Core 31 — see btcpayserver/NBXplorer#545.
BITCOIN_IMAGE=btcpayserver/bitcoin:31.0
POSTGRES_IMAGE=postgres:16
NBXPLORER_IMAGE=nicolasdorier/nbxplorer:2.6.7
FULCRUM_IMAGE=cculianu/fulcrum:v2.1.1
MARIADB_IMAGE=mariadb:10.5
MEMPOOL_BACKEND_IMAGE=mempool/backend:v3.3.1
MEMPOOL_FRONTEND_IMAGE=mempool/frontend:v3.3.1
LND_IMAGE=btcpayserver/lnd:v0.19.3-beta

# Explorer (mempool) host ports. The web frontend also serves the Esplora-
# compatible REST API under /api that arkd and fulmine consume.
MEMPOOL_WEB_PORT=3000
MEMPOOL_API_PORT=8999

# ── Base-layer host ports ──────────────────────────────────────────────────────
# Only the HOST side of each mapping; container-internal ports are fixed. Override
# any that collide locally or when running multiple regtest stacks side by side.
BITCOIN_RPC_PORT=18443
BITCOIN_P2P_PORT=18444
BITCOIN_ZMQ_BLOCK_PORT=28332
BITCOIN_ZMQ_TX_PORT=28333
NBXPLORER_PORT=32838
# Postgres backs arkd + nbxplorer. Exposed on the host (trust auth) so
# external consumers can read those DBs directly — e.g. a BTCPay ServerTester
# whose `explorer.postgres` reads NBXplorer's DB. 39372 is NBXplorer's
# conventional host port, so BTCPay's default explorer.postgres works as-is.
POSTGRES_PORT=39372
FULCRUM_TCP_PORT=50001
FULCRUM_WS_PORT=50003
# Counterparty LND (the node `lnd-peer` opens a channel to).
LND_P2P_PORT=9735
LND_RPC_PORT=10009

# Auto-miner: mine 1 block every N seconds (on by default, 10 min). Set to 0 to
# disable and mine only explicitly (`node regtest.mjs mine`) / via faucet --confirm.
# Note: arkd's default locktimes below (compose.ark.yml) are block-denominated,
# so leaving this on will eventually drive a default stack toward expiry/sweeps.
AUTOMINE_INTERVAL=600

# ── Ark stack images ─────────────────────────────────────────────────────────
# arkd is always run from these images (there is no nigiri built-in fallback).
ARKD_IMAGE=ghcr.io/arkade-os/arkd:v0.9.16
ARKD_WALLET_IMAGE=ghcr.io/arkade-os/arkd-wallet:v0.9.16
FULMINE_IMAGE=ghcr.io/arklabshq/fulmine:v0.3.25
# The peer node. BOLTZ_LND_* are still read as a fallback, so an .env written
# against the old stack keeps working.
LND_PEER_IMAGE=btcpayserver/lnd:v0.19.3-beta
WALLET_IMAGE=ghcr.io/arkade-os/wallet:latest
EXPLORER_IMAGE=ghcr.io/arklabshq/arkade-explorer:latest

# ── Ark stack host ports ─────────────────────────────────────────────────────
# arkd server (gRPC/REST) + its admin port, and arkd-wallet. lib/setup/arkd.mjs
# reads ARKD_PORT / ARKD_ADMIN_PORT to reach these on the host.
ARKD_PORT=7070
ARKD_ADMIN_PORT=7071
ARKD_WALLET_PORT=6060
LND_PEER_P2P_PORT=9736
LND_PEER_RPC_PORT=10010
DELEGATOR_GRPC_PORT=7010
DELEGATOR_API_PORT=7011
DELEGATOR_HTTP_PORT=7012
WALLET_PORT=3003
EXPLORER_PORT=7080

# ── arkd-wallet signer key ───────────────────────────────────────────────────
ARKD_WALLET_SIGNER_KEY=afcd3fa10f82a05fddc9574fdb13b3991b568e89cc39a72ba4401df8abef35f0

# ── arkd configuration ───────────────────────────────────────────────────────
ARKD_LIVE_STORE_TYPE=inmemory
ARKD_SESSION_DURATION=30

# ── Wallet setup ─────────────────────────────────────────────────────────────
ARKD_PASSWORD=secret
ARKD_FAUCET_AMOUNT=2
# Offchain funding for the delegator wallet, in sats, via a credit note.
FULMINE_NOTE_AMOUNT=100000000
LND_FAUCET_AMOUNT=2
LND_CHANNEL_SIZE=1000000

# ── Ark fees ─────────────────────────────────────────────────────────────────
ARK_OFFCHAIN_INPUT_FEE="amount * 0.01"
ARK_ONCHAIN_INPUT_FEE="amount * 0.01"
ARK_OFFCHAIN_OUTPUT_FEE="0.0"
ARK_ONCHAIN_OUTPUT_FEE="250.0"

# ── Emulator (arkade-script signing service) ─────────────────────────────────
# Default-on. Clear EMULATOR_IMAGE in your override to disable it (faster boot,
# no port 7073). regtest.mjs starts it last, after arkd is wallet-ready.
EMULATOR_IMAGE=ghcr.io/arkade-os/emulator:v0.0.7
EMULATOR_PORT=7073
# Deterministic 32-byte hex private key shared across projects so tests can pin
# to the resulting pubkey. Change only if you need an isolated emulator identity.
EMULATOR_SECRET_KEY=b1c2d3e4f5a6b7c8d9e0f1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b1c4
# Keep in sync when changing EMULATOR_SECRET_KEY.
EMULATOR_PUBKEY=02999413c46fa10ada5cbc4bcc79a1d09160c2ba3cfc812705d7a13e5e545fb2a9
# arkd hostname:port reachable inside the docker network.
EMULATOR_ARKD_URL=arkd:7070
EMULATOR_LOG_LEVEL=4

# ── covclaimd (non-interactive claim daemon) ─────────────────────────────────
# Part of the `covclaimd` profile. Clear COVCLAIMD_IMAGE in your override to
# disable it independently.
COVCLAIMD_IMAGE=ghcr.io/arkade-os/covclaimd:v0.0.1-rc.5
COVCLAIMD_HTTP_PORT=7271

# ── Solver (arkade virtual-mempool intent solver) ────────────────────────────
# Part of the `solver` profile. Depends on arkd AND the emulator
# (SOLVER_EMULATOR_URL is required), so the solver profile pulls in both.
# solverd listens on 7170 (gRPC) / 7171 (HTTP) inside the container; its host
# ports are remapped (7090/7091) to avoid a collision with arkd's 7070/7071.
SOLVER_IMAGE=ghcr.io/arkade-os/solver:v0.0.6
SOLVER_GRPC_PORT=7090
SOLVER_HTTP_PORT=7091
# Deterministic 32-byte (64 hex chars) wallet seed so tests can pin to the
# solver identity. Must be even-length hex — solverd hex-decodes it on boot.
SOLVER_WALLET_SEED=2f5b9e1c7a3d4f6082b1c8d9e0a7f3b46c5d2e1f0a9b8c7d6e5f4a3b2c1d0e9f
SOLVER_WALLET_PASSWORD=password
SOLVER_LOG_LEVEL=4

# On start, the solver is bootstrapped like the solver repo's `make init-solverd`:
# funded with BTC + a freshly minted asset, with a BTC/<asset> market registered
# against the mock pricefeed below. PRICEFEED_PORT exposes the feed for debugging;
# solverd itself reads it over the docker network.
PRICEFEED_PORT=8088
SOLVER_INIT_BTC=1000000
SOLVER_INIT_ASSET_SUPPLY=100000
SOLVER_INIT_ASSET_FUNDING=50000

# ── Intent solver (Lightning <-> Arkade swap solver) ─────────────────────────
# arkade-os/intent-solver, the reference swap solver — NOT the `solver` above,
# which is solverd. Part of the `intent-solver` profile, which pulls in `ark`,
# `emulator` AND `lightning`: that setup is the only thing that funds the base
# `lnd` node and opens the channel its Lightning corridors need.
#
# ON by default now that the image is published. The registry tag carries NO
# leading `v` — release.yml renders `type=semver,pattern={{version}}`, so the
# git tag `v0.2.1` publishes `0.2.1`. Pinning `v0.2.1` here fails the pull.
#
# Clear it to turn the profile off — the same "clear the image to disable it"
# idiom as EMULATOR_IMAGE.
INTENT_SOLVER_IMAGE=ghcr.io/arkade-os/intent-solver:0.2.1
# Host port for its `serve` HTTP API (container-internal 8787 is fixed).
INTENT_SOLVER_PORT=8787
# Throwaway BIP39 seed for the solver's Arkade wallet, fixed so its address is
# stable across restarts and tests can pin to it. Regtest only — this phrase is
# public, so never send real funds to anything derived from it.
INTENT_SOLVER_MNEMONIC="planet travel grab found idle ripple acoustic hero normal mixed rich lamp"
# Arkade float sent to the solver on start, in sats. Distinct from its Lightning
# side, which setupLightning() funds: the RECEIVE corridors fund a lockup out of
# THIS balance, so at 0 the solver quotes and then cannot fill. Set 0 to skip.
INTENT_SOLVER_FLOAT_SATS=5000000

# ── Bucket sync server (end-to-end-encrypted key/value bucket sync) ──────────
# Part of the `sync` profile, which needs only `base`: the server stores opaque
# ciphertext under a client-owned key namespace and has no Ark dependency, so
# `--profile sync` skips arkd entirely. Point a client at it with
# BUCKET_SYNC_URL=http://localhost:${BUCKET_SYNC_PORT}.
BUCKET_SYNC_IMAGE=ghcr.io/kukks/bucket-sync-server:latest
BUCKET_SYNC_PORT=7100
# Its own database on the shared postgres, created on `start` by the one-shot
# bucket-sync-initdb container (the shared postgres only auto-creates `arkd`).
BUCKET_SYNC_DB=bucketsync
# The server sends no CORS headers unless told to, which blocks browser clients on
# another origin (the web wallet on :3003, a Vite dev server, ...). Regtest is a local
# dev stack, so allow any origin by default. Narrow it to a comma-separated list, or
# clear it (BUCKET_SYNC_CORS=) to send no CORS headers at all.
BUCKET_SYNC_CORS=*

# ── strfry (Nostr relay) ─────────────────────────────────────────────────────
# Part of the `nostr` profile, which needs only `base`: a relay stores signed
# events and knows nothing about Ark, so `--profile nostr` skips arkd entirely.
# Point a client at ws://localhost:${STRFRY_PORT} (the same port answers plain
# HTTP for the NIP-11 relay document). Settings that aren't a port live in
# docker/strfry.conf — strfry configures itself from one file, not env vars.
# Upstream publishes only a mutable `latest`; pin a digest here for a build that
# can't move under you (docker/strfry.conf is a copy of that image's defaults).
STRFRY_IMAGE=ghcr.io/hoytech/strfry:latest
STRFRY_PORT=7777
